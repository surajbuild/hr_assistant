DATABASE_URL=mysql+pymysql://root:password@localhost:3306/ai_hr_assistant
JWT_SECRET_KEY=your-super-secret-key-change-this-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
SESSION_SECRET_KEY=your-session-secret-key-for-oauth-state

# Google OAuth 2.0 / OIDC Credentials (from Google Cloud Console)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback

# AI / LLM Configuration (OpenAI or OpenAI-compatible provider)
LLM_API_KEY=your-llm-api-key
LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=https://api.openai.com/v1

# Frontend / integration
# Where the Bun dev server proxies /api/* (read by frontend/src/index.ts)
BACKEND_URL=http://localhost:8000
# Where Google OAuth redirects back with #token=... when login starts from the SPA (?next=frontend)
FRONTEND_URL=http://localhost:3000

# RAG document storage (defaults to ./documents)
# DOCUMENTS_DIR=D:/path/to/documents
