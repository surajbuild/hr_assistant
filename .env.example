DATABASE_URL=mysql+pymysql://root:password@localhost:3306/ai_hr_assistant

# Signing secrets — REQUIRED, at least 32 bytes each, different from each other.
# The backend refuses to start with a missing/short secret or with these placeholders (KI-003, KI-011).
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"   (changing JWT_SECRET_KEY logs everyone out)
JWT_SECRET_KEY=your-super-secret-key-change-this-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
SESSION_SECRET_KEY=your-session-secret-key-for-oauth-state

# Rate limiting (D-031) — in-memory, per backend process (run a single uvicorn worker)
# RATE_LIMIT_ENABLED=true
# RATE_LIMIT_LOGIN_PER_MINUTE=30                 # all login attempts per client IP
# RATE_LIMIT_LOGIN_FAILURES=5                    # failed logins per (client IP, email) ...
# RATE_LIMIT_LOGIN_FAILURE_WINDOW_SECONDS=900    # ... within this window
# RATE_LIMIT_CHAT_PER_MINUTE=20                  # POST /chat per user
# Proxies whose X-Forwarded-For is trusted (IPs or CIDRs). The Bun server sets it to the real client IP.
# TRUSTED_PROXY_IPS=127.0.0.1,::1

# Google OAuth 2.0 / OIDC Credentials (from Google Cloud Console)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback

# AI / LLM Configuration (OpenAI-compatible provider; the project uses OpenRouter — these are also the code defaults).
# For OpenAI directly: LLM_MODEL=gpt-4o-mini, LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=your-llm-api-key
LLM_MODEL=openai/gpt-4o-mini
LLM_BASE_URL=https://openrouter.ai/api/v1

# Frontend / integration
# Where the Bun dev server proxies /api/* (read by frontend/src/index.ts)
BACKEND_URL=http://localhost:8000
# Where Google OAuth redirects back with #token=... when login starts from the SPA (?next=frontend)
FRONTEND_URL=http://localhost:3000

# RAG document storage (defaults to ./documents)
# DOCUMENTS_DIR=D:/path/to/documents

# ---------------------------------------------------------------------------
# Docker (docker-compose.yml) — only read by `docker compose`; ignored by local dev.
# Uncomment and set before `docker compose up -d --build`. In Docker, DATABASE_URL, BACKEND_URL,
# DOCUMENTS_DIR and TRUSTED_PROXY_IPS above are overridden by docker-compose.yml.
# The secrets above (JWT_SECRET_KEY, SESSION_SECRET_KEY, LLM_API_KEY, ...) are still required.
# ---------------------------------------------------------------------------
# MySQL container credentials (REQUIRED for Docker). Use URL-safe passwords (letters, digits, - _ .),
# they are embedded in the backend's DATABASE_URL. Generate: python -c "import secrets; print(secrets.token_urlsafe(24))"
# MYSQL_ROOT_PASSWORD=change-me-root-password
# MYSQL_DATABASE=ai_hr_assistant
# MYSQL_USER=hr_app
# MYSQL_PASSWORD=change-me-app-password
# First start only: seed the demo dataset (scripts/seed_db.py) when the database is EMPTY. Never re-seeds.
# SEED_DEMO_DATA=false
# Host port for the web UI (the backend and MySQL are not published)
# FRONTEND_PORT=3000
# Internal Docker network and the frontend's fixed IP in it; the backend trusts X-Forwarded-For
# only from FRONTEND_IP (the Bun proxy). FRONTEND_IP must lie inside DOCKER_SUBNET.
# DOCKER_SUBNET=172.28.0.0/16
# FRONTEND_IP=172.28.0.10
# Container timezone — attendance check-in / late / overtime use local time
# TZ=Asia/Kolkata
